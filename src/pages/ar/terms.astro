---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import i18next from "../../lib/i18n";

await i18next.changeLanguage("ar");
---

<Layout title="الشروط والأحكام" lang="ar">
  <Header lang="ar" />

  <main>
    <section class="page-hero">
      <div class="container">
        <h1>الشروط والأحكام</h1>
        <p>استخدام هذا الموقع يعني قبول الشروط التالية.</p>
      </div>
    </section>

    <section class="page-content">
      <div class="container">
        <h2 class="section-title-alt">عام</h2>
        <p class="muted">المحتوى للمعلومات العامة فقط ولا يضمن التغطية.</p>
        <h2 class="section-title-alt" style="margin-top:1.5rem;">البوالص</h2>
        <p class="muted">جميع البوالص تخضع لشروط واستثناءات شركة التأمين.</p>
        <h2 class="section-title-alt" style="margin-top:1.5rem;">المسؤولية</h2>
        <p class="muted">لا تتحمل أمين أي أضرار ناتجة عن استخدام الموقع أو الاعتماد على محتواه.</p>
      </div>
    </section>
  </main>

  <Footer lang="ar" />
</Layout>
