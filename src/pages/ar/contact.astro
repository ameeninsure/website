---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import i18next from "../../lib/i18n";

await i18next.changeLanguage("ar");
---

<Layout title="اتصل بنا" lang="ar">
  <Header lang="ar" />

  <main>
    <section class="page-hero">
      <div class="container">
        <h1>اتصل بنا</h1>
        <p>تواصل مع فريقنا للحصول على استشارة أو عرض مخصص.</p>
      </div>
    </section>

    <section class="page-content">
      <div class="container two-col">
        <div>
          <h2 class="section-title-alt">معلومات التواصل</h2>
          <p class="muted">نرد خلال يوم عمل واحد.</p>
          <div style="margin-top:1rem;">
            <p><strong>الهاتف:</strong> +968 76888817</p>
            <p><strong>البريد:</strong> info@ameen.me</p>
            <p><strong>الموقع:</strong> مسقط، عمان</p>
          </div>
        </div>
        <form class="card form">
          <input type="text" placeholder="الاسم الكامل" aria-label="الاسم الكامل" />
          <input type="email" placeholder="البريد الإلكتروني" aria-label="البريد الإلكتروني" />
          <input type="tel" placeholder="رقم الهاتف" aria-label="رقم الهاتف" />
          <textarea placeholder="كيف يمكننا مساعدتك؟" aria-label="الرسالة"></textarea>
          <button type="submit" class="btn btn-primary">إرسال الرسالة</button>
        </form>
      </div>
    </section>

    <section class="map-section" dir="rtl" aria-label="خريطة موقع أمين">
      <div class="container">
        <div class="map-embed">
          <iframe
            title="موقع أمين"
            src="https://www.openstreetmap.org/export/embed.html?bbox=58.357392%2C23.5819%2C58.367392%2C23.5919&layer=mapnik&marker=23.5869%2C58.362392"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    </section>
  </main>

  <Footer lang="ar" />
</Layout>

<style>
  .map-section {
    padding: 0 0 4rem;
  }

  .map-embed {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(15, 23, 42, 0.12);
    border: 1px solid rgba(15, 23, 42, 0.08);
    height: 380px;
  }

  .map-embed iframe {
    width: 100%;
    height: calc(100% + 30px);
    border: 0;
    display: block;
  }

  .map-embed::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  @media (max-width: 768px) {
    .map-embed {
      height: 320px;
    }
  }
</style>
