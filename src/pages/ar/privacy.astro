---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import i18next from "../../lib/i18n";

await i18next.changeLanguage("ar");
---

<Layout title="سياسة الخصوصية" lang="ar">
  <Header lang="ar" />

  <main>
    <section class="page-hero">
      <div class="container">
        <h1>سياسة الخصوصية</h1>
        <p>نحترم خصوصيتك ونحمي بياناتك الشخصية.</p>
      </div>
    </section>

    <section class="page-content">
      <div class="container">
        <h2 class="section-title-alt">البيانات التي نجمعها</h2>
        <p class="muted">نجمع البيانات التي تقدمها عند طلب عرض أو شراء وثيقة أو التواصل معنا (مثل الاسم، رقم الهاتف، البريد الإلكتروني، وتفاصيل التأمين). وقد نجمع بيانات استخدام أساسية ومعرفات الأجهزة لتحسين تجربة الموقع.</p>

        <h2 class="section-title-alt" style="margin-top:1.5rem;">كيفية استخدام البيانات</h2>
        <p class="muted">نستخدم بياناتك لتقديم العروض، إتمام الشراء، دعم الاستفسارات المتعلقة بالمطالبات، التواصل بالتحديثات، وتحسين خدماتنا. وقد نتواصل معك عبر الهاتف أو الرسائل النصية أو البريد الإلكتروني أو تطبيقات المراسلة لخدمات ذات صلة.</p>

        <h2 class="section-title-alt" style="margin-top:1.5rem;">المشاركة والإفصاح</h2>
        <p class="muted">قد نشارك بياناتك مع شركات التأمين ومزودي الخدمات لتقديم التغطية والدعم التشغيلي. وقد نفصح عن البيانات عند المتطلبات القانونية أو لمنع الاحتيال والمخاطر الأمنية.</p>

        <h2 class="section-title-alt" style="margin-top:1.5rem;">ملفات تعريف الارتباط والتخزين المحلي</h2>
        <p class="muted">نستخدم ملفات تعريف الارتباط والتخزين المحلي لتذكر تفضيلاتك وفهم استخدام الموقع. يمكنك التحكم بها عبر إعدادات المتصفح، لكن تعطيلها قد يحد من بعض الوظائف.</p>

        <h2 class="section-title-alt" style="margin-top:1.5rem;">الأمن والاحتفاظ</h2>
        <p class="muted">نتبع إجراءات أمنية معقولة لحماية بياناتك. نحتفظ بالبيانات للمدة اللازمة لتقديم الخدمة والامتثال للمتطلبات القانونية والتشغيلية.</p>

        <h2 class="section-title-alt" style="margin-top:1.5rem;">حقوقك</h2>
        <p class="muted">يمكنك طلب الوصول إلى بياناتك أو تصحيحها أو حذفها وفقاً للتحقق والمتطلبات القانونية.</p>

        <h2 class="section-title-alt" style="margin-top:1.5rem;">نقل البيانات دولياً</h2>
        <p class="muted">قد تتم معالجة البيانات خارج سلطنة عمان مع تطبيق الضمانات المناسبة والالتزام بالقوانين المعمول بها.</p>

        <h2 class="section-title-alt" style="margin-top:1.5rem;">تواصل معنا</h2>
        <p class="muted">لاستفسارات الخصوصية: info@ameen.me.</p>
      </div>
    </section>
  </main>

  <Footer lang="ar" />
</Layout>
