---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import i18next from "../lib/i18n";

await i18next.changeLanguage("en");
---

<Layout title="Terms & Conditions" lang="en">
  <Header lang="en" />

  <main>
    <section class="page-hero">
      <div class="container">
        <h1>Terms & Conditions</h1>
        <p>Use of this website implies acceptance of the following terms.</p>
      </div>
    </section>

    <section class="page-content">
      <div class="container">
        <h2 class="section-title-alt">Acceptance of Terms</h2>
        <p class="muted">By accessing or using Ameen’s website, you agree to these Terms & Conditions and any updates we publish from time to time.</p>

        <h2 class="section-title-alt" style="margin-top:1.5rem;">Eligibility & Accuracy</h2>
        <p class="muted">Our services are intended for users aged 18+ in Oman. You agree to provide accurate, current information when requesting quotes or purchasing coverage.</p>

        <h2 class="section-title-alt" style="margin-top:1.5rem;">Service Scope</h2>
        <p class="muted">Ameen is a licensed insurance broker. Quotes and policies are issued by insurers and remain subject to their terms, conditions, exclusions, and underwriting approval.</p>

        <h2 class="section-title-alt" style="margin-top:1.5rem;">Quotes, Purchase & Coverage Start</h2>
        <p class="muted">Pricing and availability can change based on risk details and insurer rules. Coverage begins only after the insurer issues the policy and confirms activation, unless explicitly stated otherwise.</p>

        <h2 class="section-title-alt" style="margin-top:1.5rem;">Cancellations & Refunds</h2>
        <p class="muted">If a policy has not been issued, we will refund any paid amount in full. If a policy has been issued, refunds (if any) are subject to the insurer’s cancellation policy and applicable fees. Certain products (e.g., active travel insurance) may be non-refundable once effective.</p>

        <h2 class="section-title-alt" style="margin-top:1.5rem;">Prohibited Use</h2>
        <p class="muted">You may not misuse the site, attempt unauthorized access, scrape data, or use automated tools that disrupt service integrity.</p>

        <h2 class="section-title-alt" style="margin-top:1.5rem;">Third-Party Links</h2>
        <p class="muted">We may link to third-party websites or services. Ameen is not responsible for their content or policies.</p>

        <h2 class="section-title-alt" style="margin-top:1.5rem;">Liability</h2>
        <p class="muted">Ameen provides information “as is” and is not liable for damages arising from the use of this site or reliance on its content.</p>

        <h2 class="section-title-alt" style="margin-top:1.5rem;">Governing Law</h2>
        <p class="muted">These Terms are governed by the laws of the Sultanate of Oman, and any disputes are subject to its courts.</p>

        <h2 class="section-title-alt" style="margin-top:1.5rem;">Contact</h2>
        <p class="muted">Questions? Contact us at info@ameen.me or +968 76888817.</p>
      </div>
    </section>
  </main>

  <Footer lang="en" />
</Layout>
