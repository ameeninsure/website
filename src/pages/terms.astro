---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import i18next from "../lib/i18n";

await i18next.changeLanguage("en");
---

<Layout title="Terms & Conditions" lang="en">
  <Header lang="en" />

  <main>
    <section class="page-hero">
      <div class="container">
        <h1>Terms & Conditions</h1>
        <p>Use of this website implies acceptance of the following terms.</p>
      </div>
    </section>

    <section class="page-content">
      <div class="container">
        <h2 class="section-title-alt">General</h2>
        <p class="muted">Content is provided for general information only and does not guarantee coverage.</p>
        <h2 class="section-title-alt" style="margin-top:1.5rem;">Policies</h2>
        <p class="muted">All policies are subject to insurer terms, conditions, and exclusions.</p>
        <h2 class="section-title-alt" style="margin-top:1.5rem;">Liability</h2>
        <p class="muted">Ameen is not liable for any damages arising from use of this site or reliance on its content.</p>
      </div>
    </section>
  </main>

  <Footer lang="en" />
</Layout>
