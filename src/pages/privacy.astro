---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import i18next from "../lib/i18n";

await i18next.changeLanguage("en");
---

<Layout title="Privacy Policy" lang="en">
  <Header lang="en" />

  <main>
    <section class="page-hero">
      <div class="container">
        <h1>Privacy Policy</h1>
        <p>We respect your privacy and protect your personal information.</p>
      </div>
    </section>

    <section class="page-content">
      <div class="container">
        <h2 class="section-title-alt">Information We Collect</h2>
        <p class="muted">We collect information you submit when requesting a quote, purchasing a policy, or contacting us (e.g., name, phone, email, and insurance-related details). We may also collect basic usage data and device identifiers to improve the site experience.</p>

        <h2 class="section-title-alt" style="margin-top:1.5rem;">How We Use Information</h2>
        <p class="muted">We use your data to provide quotes, facilitate purchases, support claims-related inquiries, communicate updates, and improve our services. We may contact you via phone, SMS, email, or messaging apps for service updates and relevant offers.</p>

        <h2 class="section-title-alt" style="margin-top:1.5rem;">Sharing & Disclosure</h2>
        <p class="muted">We may share your data with insurers and service providers to deliver coverage and support operations. We may also disclose information when required by law or to prevent fraud and security risks.</p>

        <h2 class="section-title-alt" style="margin-top:1.5rem;">Cookies & Local Storage</h2>
        <p class="muted">We use cookies and local storage to remember preferences and understand site usage. You can manage cookies through your browser settings, but disabling them may limit functionality.</p>

        <h2 class="section-title-alt" style="margin-top:1.5rem;">Security & Retention</h2>
        <p class="muted">We apply reasonable technical and organizational safeguards to protect your data. We retain information only as long as needed for service delivery, legal compliance, and operational requirements.</p>

        <h2 class="section-title-alt" style="margin-top:1.5rem;">Your Rights</h2>
        <p class="muted">You may request access, correction, or deletion of your personal data. Requests are subject to verification and applicable legal obligations.</p>

        <h2 class="section-title-alt" style="margin-top:1.5rem;">International Transfers</h2>
        <p class="muted">If data is processed outside Oman, we ensure appropriate safeguards and compliance with applicable laws.</p>

        <h2 class="section-title-alt" style="margin-top:1.5rem;">Contact</h2>
        <p class="muted">For privacy questions, contact us at info@ameen.me.</p>
      </div>
    </section>
  </main>

  <Footer lang="en" />
</Layout>
