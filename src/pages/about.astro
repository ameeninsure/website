---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import i18next from "../lib/i18n";

await i18next.changeLanguage("en");
---

<Layout title="About Ameen" lang="en">
  <Header lang="en" />

  <main>
    <section class="page-hero">
      <div class="container">
        <h1>About Ameen</h1>
        <p>Legacy secured. Future assured. Ameen is the evolved identity of Regal Insurance Management Services LLC, serving Oman since 2010.</p>
      </div>
    </section>

    <section class="page-content">
      <div class="container two-col">
        <div>
          <h2 class="section-title-alt">Who We Are</h2>
          <p class="muted">We are a licensed insurance brokerage firm in Oman, offering transparent, reliable, and tailored insurance solutions for individuals and corporates.</p>
          <div class="badge-list" style="margin-top:1rem;">
            <span class="badge">Licensed Broker</span>
            <span class="badge">Since 2010</span>
            <span class="badge">Oman</span>
          </div>
        </div>
        <div class="card">
          <h3>Our Mission</h3>
          <p>To protect what matters most by delivering dependable coverage, honest advice, and seamless claims support.</p>
          <h3 style="margin-top:1rem;">Our Vision</h3>
          <p>To be Oman’s most trusted insurance partner through professionalism, integrity, and innovation.</p>
        </div>
      </div>
    </section>

    <section class="page-content" id="values">
      <div class="container">
        <h2 class="section-title-alt">Our Values</h2>
        <div class="card-grid">
          <div class="card">
            <h3>Truth</h3>
            <p>We provide clear, honest guidance for every policy and decision.</p>
          </div>
          <div class="card">
            <h3>Trust</h3>
            <p>We build long-term partnerships with clients and insurers.</p>
          </div>
          <div class="card">
            <h3>Transparency</h3>
            <p>No hidden terms. No surprises. Just real protection.</p>
          </div>
          <div class="card">
            <h3>Expertise</h3>
            <p>Strategic alliances and local experience you can rely on.</p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer lang="en" />
</Layout>
