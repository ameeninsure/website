---
import { FiGlobe } from "react-icons/fi";

const { lang, currentPath } = Astro.props;

// Toggle between languages
const otherLang = lang === "en" ? "ar" : "en";
const otherLangName = lang === "en" ? "العربية" : "English";

// Generate the path for the other language
let otherLangPath = "/";
if (lang === "en") {
  otherLangPath = currentPath === "/" ? "/ar" : `/ar${currentPath}`;
} else if (lang === "ar") {
  otherLangPath = currentPath.replace("/ar", "") || "/";
}
---

<div class="language-switcher">
  <a href={otherLangPath} class="lang-link">
    <FiGlobe className="lang-icon" />
    <span>{otherLangName}</span>
  </a>
</div>

<style>
  .language-switcher {
    display: flex;
    align-items: center;
  }

  .lang-link {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 1rem;
    border-radius: 0.375rem;
    color: var(--color-primary);
    font-weight: 500;
    transition: all 0.3s ease;
    line-height: 1.2;
  }

  .lang-link:hover {
    background-color: var(--color-bg-light);
    color: var(--color-secondary);
  }

  .lang-icon {
    width: 20px;
    height: 20px;
    display: block;
  }
</style>
