---
const { lang, currentPath } = Astro.props;

// Toggle between languages
const otherLang = lang === "en" ? "ar" : "en";
const otherLangName = lang === "en" ? "العربية" : "English";

// Generate the path for the other language
let otherLangPath = "/";
if (lang === "en") {
  otherLangPath = currentPath === "/" ? "/ar" : `/ar${currentPath}`;
} else if (lang === "ar") {
  otherLangPath = currentPath.replace("/ar", "") || "/";
}
---

<div class="language-switcher">
  <a href={otherLangPath} class="lang-link">
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="10"></circle>
      <line x1="2" y1="12" x2="22" y2="12"></line>
      <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
    </svg>
    <span>{otherLangName}</span>
  </a>
</div>

<style>
  .language-switcher {
    display: flex;
    align-items: center;
  }

  .lang-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    border-radius: 0.375rem;
    color: var(--color-primary);
    font-weight: 500;
    transition: all 0.3s ease;
  }

  .lang-link:hover {
    background-color: var(--color-bg-light);
    color: var(--color-secondary);
  }

  .lang-link svg {
    width: 20px;
    height: 20px;
  }
</style>
